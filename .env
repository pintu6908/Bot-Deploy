# ============================================================
# TELEGRAM
# ============================================================

# Get this from @BotFather
BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN

# Your Telegram numeric user ID
# Used for admin-only commands.
ADMIN_ID=YOUR_TELEGRAM_USER_ID


# ============================================================
# TeraBox Gateway
# ============================================================

# URL of your deployed TeraBox Gateway service.
# Example:
# TERABOX_GATEWAY_URL=https://your-terabox-gateway.up.railway.app
TERABOX_GATEWAY_URL=

# Optional gateway API key.
# Leave empty if your gateway does not require authentication.
TERABOX_GATEWAY_API_KEY=


# ============================================================
# Instagram
# ============================================================

# Instagram resolver/downloader configuration.
#
# The bot is designed for publicly accessible Instagram
# Reel/Post URLs. Do not use credentials to bypass private
# accounts, authentication, OTP, or access controls.

INSTAGRAM_RESOLVER_URL=

# Optional API key if your chosen resolver requires one.
INSTAGRAM_API_KEY=


# ============================================================
# DOWNLOAD / FILE LIMITS
# ============================================================

# Temporary directory used while processing media.
DOWNLOAD_DIR=/tmp/telegram_media

# Maximum download size in MB.
MAX_DOWNLOAD_MB=2000

# Maximum simultaneous downloads.
MAX_CONCURRENT_DOWNLOADS=2


# ============================================================
# BOT BEHAVIOUR
# ============================================================

# Delete temporary files after sending media.
CLEANUP_AFTER_SEND=true

# Show download progress to users.
SHOW_PROGRESS=true

# Language used by the bot UI.
BOT_LANGUAGE=en


# ============================================================
# OPTIONAL
# ============================================================

# HTTP request timeout in seconds.
REQUEST_TIMEOUT=60

# Logging level:
# DEBUG / INFO / WARNING / ERROR
LOG_LEVEL=INFO
